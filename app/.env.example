# Supabase usa la URL del proyecto y la Publishable key (ambas aptas para el cliente).
# Configuralas en app/.env.local; nunca pongas una secret/service_role en VITE_*.
# VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Temporalmente, la app actual sigue usando PocketBase hasta completar el cambio de backend.
# Por defecto Vite reenvía /api a PocketBase (puerto 8090); para otro servidor:
# VITE_PB_URL=https://presupuestos.tuempresa.com.ar
