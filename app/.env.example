# La app web se conecta directamente a Supabase con estas variables públicas.
# Nunca coloques una secret/service_role en variables con prefijo VITE_.
VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE_PUBLICA

# Dirección pública de la app (Vercel). Se usa en los datos de acceso de empleados
# y en los enlaces para recuperar la contraseña, aunque trabajes desde localhost.
VITE_APP_URL=https://TU-APP.vercel.app
